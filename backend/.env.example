# Noorix Backend — انسخ إلى .env وعدّل القيم
PORT=3000

# ── قاعدة البيانات (Hostinger VPS — PostgreSQL محلي) ──
# على السيرفر: postgresql://postgres:PASSWORD@localhost:5432/noorix
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/noorix"

# ── الأمان ──
JWT_SECRET=your-secret-min-32-chars-change-in-production
JWT_EXPIRES_IN=8h
ADMIN_DEFAULT_PASSWORD=change-this-strong-password-in-production
# بريد المسؤول الافتراضي عند الـ seed (افتراضي: admin@hajrix.com)
# ADMIN_EMAIL=admin@hajrix.com
# نطاق البريد الرسمي لإنشاء مستخدمين جدد بدون إدخال بريد يدوي
# OFFICIAL_EMAIL_DOMAIN=hajrix.com

# ── CORS: أضف دومين الـ Frontend ──
# CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com

# ── Gemini API — للمحادثة الذكية (اختياري) ──
# احصل على المفتاح من: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_OPEN_MODE=true

# ── النسخ الاحتياطي (اختياري) ──
# BACKUP_LOCAL_DIR=./data/backups
# BACKUP_GDRIVE_SCRIPT_URL=

