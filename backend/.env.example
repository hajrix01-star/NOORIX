# Noorix Backend — انسخ إلى .env وعدّل القيم
PORT=3000

# ── Redis (طابور Bull — استخراج OCR؛ تشغيل محلي: docker compose up -d redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── قاعدة البيانات (Hostinger VPS — PostgreSQL محلي) ──
# على السيرفر: postgresql://postgres:PASSWORD@localhost:5432/noorix
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/noorix"

# ── الأمان ──
JWT_SECRET=your-secret-min-32-chars-change-in-production

# HAJRIIX ADMIN read-only owner dashboard integration.
# Store only SHA-256 of the generated token here; never the plain token.
# ADMIN_DASHBOARD_TOKEN_SHA256=
# ADMIN_DASHBOARD_TENANT_ID=
# ADMIN_DASHBOARD_COMPANY_IDS=company-id-1,company-id-2
JWT_EXPIRES_IN=8h
ADMIN_DEFAULT_PASSWORD=change-this-strong-password-in-production
# بريد المسؤول الافتراضي عند الـ seed (افتراضي: admin@hajrix.com)
# ADMIN_EMAIL=admin@hajrix.com
# نطاق البريد الرسمي لإنشاء مستخدمين جدد بدون إدخال بريد يدوي
# OFFICIAL_EMAIL_DOMAIN=hajrix.com

# ── CORS: واجهة المستخدم (نطاقات مفصولة بفواصل) — مهم للمتصفح؛ الإنتاج الافتراضي: hajrix.com إن وُضع في main/ecosystem
# CORS_ORIGIN=https://hajrix.com,https://www.hajrix.com

# ── Gemini API — للمحادثة الذكية (اختياري) ──
# احصل على المفتاح من: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_OPEN_MODE=true
# شرح رؤى لوحة التحكم عبر LLM فوق الرد الحتمي — افتراضي معطّل (يُشترط GEMINI_API_KEY)
# SMART_CHAT_INSIGHTS_LLM_EXPLANATION=false
# أقصى طلبات Gemini متوازية لكل عملية Node (افتراضي 2)
# GEMINI_MAX_CONCURRENT=2
# ترتيب نماذج OCR (اختياري) مفصولة بفواصل — يستخدم قبل fallback chain
# OCR_GEMINI_MODEL_PRIORITY=gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash
# أقصى عدد نماذج OCR يُجرّبها الاستخراج لكل فاتورة
# OCR_GEMINI_MAX_MODELS_TO_TRY=5
# عدد مهام OCR المتوازية في Bull worker (افتراضي 1 للحذر في الإنتاج)
# OCR_QUEUE_CONCURRENCY=1
# تشغيل الاستخراج مباشرة بدون Bull (مفيد إذا Redis غير متاح)
# OCR_INLINE_EXTRACTION=false
# Sweeper: معالجة queued العالقة بعد N ثانية (افتراضي 60)
# OCR_QUEUE_STUCK_SECONDS=60
# Sweeper: إعادة queued إذا extracting أطول من N دقيقة (افتراضي 15)
# OCR_EXTRACTING_STUCK_MINUTES=15
# تفعيل/تعطيل تحسين الصورة قبل OCR (rotate/resize/normalize/sharpen)
# OCR_IMAGE_PREPROCESS_ENABLED=true
# أقصى ضلع للصورة بعد التحسين (لتقليل الضوضاء وتكلفة الـOCR)
# OCR_IMAGE_MAX_DIMENSION=2200
# جودة JPEG لصورة OCR المُعالجة
# OCR_IMAGE_JPEG_QUALITY=88
# عتبات quality flags للصورة (اختياري)
# OCR_IMAGE_MIN_SIDE_PX=900
# OCR_IMAGE_MIN_ENTROPY=3.2
# OCR_IMAGE_MIN_SHARPNESS=6
# هل يسمح للاستخراج وحده بتعديل كتالوج OCR (تعلم alias/تحديث hasSizes)؟
# الافتراضي الآمن: false — لا تعديلات كتالوج قبل save/finalize
# OCR_ALLOW_CATALOG_MUTATION_ON_EXTRACT=false

# مراقبة (اختياري — عند الربط بـ Sentry أو بديل)
# SENTRY_DSN=
# نسبة تتبع الأداء (0.0–1.0) — عند تفعيل Sentry في PR منفصل
# SENTRY_TRACES_SAMPLE_RATE=0.1

# تخزين كائنات لاحقاً (S3/B2) — لا يُفعل تلقائياً؛ يبقى المسار المحلي + VOLUME حتى قرار النشر
# AWS_S3_BUCKET=
# AWS_REGION=
# AWS_S3_ENDPOINT=   # لـ MinIO/B2 S3-compatible عند الحاجة

# ── النسخ الاحتياطي (اختياري) ──
# BACKUP_LOCAL_DIR=./data/backups
# BACKUP_GDRIVE_SCRIPT_URL=
# استخدم هذا لنسخ النظام الكامل إذا كان DATABASE_URL يستخدم role خاضع لـ RLS.
# يجب أن يكون مستخدم النسخ قادرا على قراءة كل الجداول، مثل postgres أو role لديه BYPASSRLS.
# BACKUP_DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/noorix"
# Optional: use a role that can CREATE/DROP a temporary verification database.
# If omitted, BACKUP_DATABASE_URL is used, then DATABASE_URL.
# BACKUP_VERIFY_DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/noorix"

# أرشيف نظام كامل (pg_dump custom + مجلد uploads في tar.gz) — منفصل عن النسخة اليومية .dump.gz
# للجدولة الأسبوعية: BACKUP_SYSTEM_FULL_WEEKLY=1 + يوم/ساعة/دقيقة بتوقيت system_backup_config.timezone
# BACKUP_SYSTEM_FULL_WEEKLY=1
# BACKUP_SYSTEM_FULL_WEEKDAY=0
# BACKUP_SYSTEM_FULL_HOUR=3
# BACKUP_SYSTEM_FULL_MINUTE=0
# أو تشغيل مجدول عند كل tick إن BACKUP_SYSTEM_FULL_ENABLED=true (للاختبار فقط)
# BACKUP_SYSTEM_FULL_ENABLED=false

# استيراد لقطة منطقية: إن 1 يُلغى الاستيراد بالكامل عند أي تعارض توزيعات خزائن vs إجمالي فاتورة (بدون تفعيل من الواجهة)
# BACKUP_LOGICAL_IMPORT_FAIL_ON_ALLOCATION_WARNINGS=0

