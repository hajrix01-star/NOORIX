// ط¬ط¯ظˆظ„ ط§ظ„ط­ط±ظƒط§طھ ط§ظ„ظ…ظˆط­ط¯ (ط§ظ„ظ‚ظٹط¯ ط§ظ„ظ…ط²ط¯ظˆط¬)
model LedgerEntry {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")      // RLS
  companyId       String   @map("company_id")
  debitAccountId  String   @map("debit_account_id")
  creditAccountId String   @map("credit_account_id")
  amount          Decimal  @db.Decimal(18, 4)
  transactionDate DateTime @map("transaction_date")
  entryDate       DateTime @map("entry_date")
  referenceType   String   @map("reference_type")  // invoice | sale | transfer | expense | salary | advance
  referenceId     String   @map("reference_id")
  vaultId         String?  @map("vault_id")
  employeeId      String?  @map("employee_id")     // ظ…ط±طھط¨ط· ط¨ط§ظ„ظ…ظˆط¸ظپ (ط±ط§طھط¨/ط³ظ„ظپظٹط©)
  createdById     String?  @map("created_by_id")   // âœ… ط¨طµظ…ط© ط§ظ„ظ…ط³طھط®ط¯ظ…
  status          String   @default("active")       // active | cancelled
  createdAt       DateTime @default(now()) @map("created_at")

  company       Company   @relation(fields: [companyId],       references: [id], onDelete: Cascade)
  debitAccount  Account   @relation("DebitAccount",  fields: [debitAccountId],  references: [id], onDelete: Restrict)
  creditAccount Account   @relation("CreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)
  vault         Vault?    @relation(fields: [vaultId],    references: [id], onDelete: SetNull)
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdBy     User?     @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, transactionDate])
  @@index([companyId, status, transactionDate])
  @@index([companyId, entryDate])
  @@index([referenceType, referenceId])
  @@index([vaultId])
  @@index([companyId, employeeId])
  @@map("ledger_entries")
}

// ط³ط¬ظ„ ط§ظ„طھط¯ظ‚ظٹظ‚ â€” ظٹظڈط³ط¬ظ‘ظ„ ط¨طµظ…ط© ط§ظ„ظ…ط³طھط®ط¯ظ… ط§ظ„ط­ظ‚ظٹظ‚ظٹط© ط¹ظ„ظ‰ ظƒظ„ ط­ط±ظƒط©
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")      // RLS
  companyId String   @map("company_id")
  userId    String?  @map("user_id")        // âœ… ط¨طµظ…ط© ط§ظ„ظ…ط³طھط®ط¯ظ… â€” ظ„ط§ ظٹظƒظˆظ† null ط¹ظ†ط¯ ط§ظ„ط­ظپط¸
  action    String   // create | update | delete | cancel
  entity    String   // invoice | ledger_entry | user | company | ...
  entityId  String   @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
