model Order {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  companyId       String   @map("company_id")
  orderNumber     String   @map("order_number")   // ORD-20260315-001
  orderDate       DateTime @map("order_date")
  orderType       String   @map("order_type")    // external | internal
  pettyCashAmount Decimal? @map("petty_cash_amount") @db.Decimal(18, 4)  // ظ„ظ„ط®ط§ط±ط¬ظٹ ظپظ‚ط·
  totalAmount     Decimal  @map("total_amount")  @db.Decimal(18, 4)
  notes               String?
  sourceStaffOrderIds Json?    @map("source_staff_order_ids")
  status              String   @default("active") @map("status")  // active | cancelled
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt      @map("updated_at")

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   OrderItem[]
  staffOrders StaffOrder[]

  @@unique([companyId, orderNumber])
  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, orderDate])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  size       String?  @map("size")       // ط§ظ„ط­ط¬ظ… ط§ظ„ظ…ط®طھط§ط±
  packaging  String?  @map("packaging")  // ط§ظ„طھط؛ظ„ظٹظپ ط§ظ„ظ…ط®طھط§ط±
  unit       String?  @map("unit")       // ط§ظ„ظˆط­ط¯ط© ط§ظ„ظ…ط®طھط§ط±ط© (piece|kg|box|dozen)
  quantity   Decimal  @db.Decimal(18, 4)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(18, 4)
  amount     Decimal  @db.Decimal(18, 4)

  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product OrderProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

