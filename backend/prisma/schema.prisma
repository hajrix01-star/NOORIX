  @@unique([companyId, employeeSerial])
  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, status])
  @@map("employees")
}

// â”€â”€ ظ…ط³ظٹط±ط© ط§ظ„ط±ظˆط§طھط¨ (ط¯ظپط¹ط© ط´ظ‡ط±ظٹط©) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model PayrollRun {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  companyId       String   @map("company_id")
  runNumber       String   @map("run_number")       // PR-2026-03
  payrollMonth    DateTime @map("payroll_month")    // ط£ظˆظ„ ظٹظˆظ… ظ…ظ† ط§ظ„ط´ظ‡ط±
  totalAmount     Decimal  @map("total_amount")     @db.Decimal(18, 4)
  employeeCount   Int      @map("employee_count")
  status          String   @default("draft")        // draft | completed
  notes           String?
  /// ط¹ظ†ط¯ ط§ظ„ط§ط¹طھظ…ط§ط¯: طھط³ظˆظٹط© ط®طµظ… ط§ظ„ط³ظ„ظپ ط¹ظ„ظ‰ ظپظˆط§طھظٹط± ط§ظ„ط³ظ„ظپ (ظٹظڈظ…ظ†ط¹ ط§ظ„طھظƒط±ط§ط± ط¹ظ†ط¯ طµط±ظپ ط§ظ„ظ…ط³ظٹط±ط© ظ„ط§ط­ظ‚ط§ظ‹)
  advanceSettlementsAppliedAt DateTime? @map("advance_settlements_applied_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   PayrollRunItem[]
  /// طھظˆط²ظٹط¹ طµط±ظپ ط§ظ„ظ…ط³ظٹط±ط© ط¹ظ„ظ‰ ط®ط²ط§ط¦ظ† (ظ…ط³طھظˆظ‰ ط§ظ„ظ…ط³ظٹط±ط© â€” ظپط§طھظˆط±ط© طµط±ظپ ظˆط§ط­ط¯ط© ط¹ظ†ط¯ ط§ظ„ط¥طµط¯ط§ط±)
  runVaultSplits PayrollRunVault[]

  @@unique([companyId, runNumber])
  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, payrollMonth])
  @@map("payroll_runs")
}

model PayrollRunItem {
  id              String   @id @default(cuid())
  payrollRunId    String   @map("payroll_run_id")
  employeeId      String   @map("employee_id")
  grossSalary     Decimal  @map("gross_salary")     @db.Decimal(18, 4)
  allowancesAdd   Decimal  @default(0) @map("allowances_add")   @db.Decimal(18, 4)  // ط¨ط¯ظ„ط§طھ ط¥ط¶ط§ظپظٹط©
  deductions      Decimal  @default(0) @map("deductions")      @db.Decimal(18, 4)  // ط®طµظˆظ…ط§طھ (ط¬ط²ط§ط،ط§طھ ظˆط؛ظٹط±ظ‡ط§)
  advancesDeduct  Decimal  @default(0) @map("advances_deduct") @db.Decimal(18, 4) // ط®طµظ… ط§ظ„ط³ظ„ظپ
  netSalary       Decimal  @map("net_salary")       @db.Decimal(18, 4)
