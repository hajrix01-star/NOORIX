// NOORIX — Enterprise SaaS Schema (Multi-Tenant)
// معمارية: Tenant → Companies → All Operational Data
// الأمان: RLS على مستوى PostgreSQL بـ app.current_tenant_id
// مرجع: docs/NOORIX_RULES.md §2.4، §7

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // shadowDatabaseUrl = env("SHADOW_DATABASE_URL") // uncomment when using prisma migrate
  // ⚠️ لا تستخدم `prisma db push --force-reset` على قاعدة البيانات الإنتاجية — يمحو البيانات كاملة
  // بدلاً من db push: استخدم `prisma migrate dev` لإنشاء ملف migration آمن
}

// ══════════════════════════════════════════════════
// TIER 1: TENANT (المنظمة / الاشتراك)
// الطبقة العليا — Tenant يملك Companies
// ══════════════════════════════════════════════════
model Tenant {
  id          String   @id @default(cuid())
  name        String                           // اسم المنظمة (مثل: مجموعة أبو مسعود)
  slug        String   @unique                 // معرّف URL فريد (abumasoud-group)
  plan        String   @default("starter")     // starter | professional | enterprise
  isActive    Boolean  @default(true)  @map("is_active")
  maxCompanies Int     @default(5)     @map("max_companies")  // حد الشركات حسب الخطة
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  companies  Company[]
  users      User[]
  backupJobs BackupJob[]
  companyBackupConfigs CompanyBackupConfig[]

  @@map("tenants")
}

// ══════════════════════════════════════════════════
// TIER 2: AUTH & PERMISSIONS
// ══════════════════════════════════════════════════
model Role {
  id                  String   @id @default(cuid())
  name                String   @unique
  nameAr              String?  @map("name_ar")
  description         String?
  permissions         String[] @default([])
  /// آخر مجموعة صلاحيات seed طُبّقت على هذا الدور — تُستخدم لاكتشاف الصلاحيات الجديدة فعلاً دون إعادة ما حذفه المدير
  lastSeedPermissions String[] @default([]) @map("last_seed_permissions")
  isSystem            Boolean  @default(false) @map("is_system")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt      @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")          // ⚠️ إلزامي — المستخدم ينتمي لـ Tenant واحد
  email           String    @unique
  passwordHash    String    @map("password_hash")
  nameAr          String?   @map("name_ar")
  nameEn          String?   @map("name_en")
  roleId          String    @map("role_id")
  preferredLang   String    @default("ar")  @map("preferred_lang")
  isActive        Boolean   @default(true)  @map("is_active")
  lastActivityAt  DateTime? @map("last_activity_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt      @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId],  references: [id], onDelete: Cascade)
  role          Role          @relation(fields: [roleId],    references: [id], onDelete: Restrict)
  userCompanies UserCompany[]
  ledgerEntries LedgerEntry[] @relation("CreatedBy")
  auditLogs     AuditLog[]
  salesSummaries DailySalesSummary[] @relation("SalesCreatedBy")
  backupJobsCreated BackupJob[] @relation("BackupCreatedBy")
  invoicesCreated Invoice[] @relation("InvoiceCreatedBy")
  ocrInvoicesSubmitted OcrInvoice[] @relation("OcrInvoiceSubmittedBy")

  @@index([tenantId])
  @@map("users")
}

// ══════════════════════════════════════════════════
// TIER 3: COMPANY (الشركة — تحت Tenant)
// ══════════════════════════════════════════════════
model Company {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")              // ⚠️ إلزامي — RLS يستخدمه
  nameAr     String   @map("name_ar")
  nameEn     String?  @map("name_en")
  logoUrl    String?  @map("logo_url")
  phone      String?
  address    String?
  taxNumber  String?  @map("tax_number")
  email      String?
  isArchived Boolean  @default(false) @map("is_archived")
  vatEnabledForSales Boolean @default(false) @map("vat_enabled_for_sales")
  vatRatePercent     Decimal  @default(15)   @map("vat_rate_percent") @db.Decimal(5, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt      @map("updated_at")

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userCompanies       UserCompany[]
  suppliers           Supplier[]
  vaults              Vault[]
  accounts            Account[]
  invoices            Invoice[]
  ledgerEntries       LedgerEntry[]
  auditLogs           AuditLog[]
  dailySalesSummaries DailySalesSummary[]
  categories          Category[]
  employees           Employee[]
  payrollRuns         PayrollRun[]
  leaves              Leave[]
  employeeResidencies EmployeeResidency[]
  employeeDocuments   EmployeeDocument[]
  employeeMovements   EmployeeMovement[]
  employeeCustomAllowances EmployeeCustomAllowance[]
  employeeDeductions  EmployeeDeduction[]
  fiscalPeriods       FiscalPeriod[]
  expenseLines        ExpenseLine[]
  orders              Order[]
  orderProducts       OrderProduct[]
  orderCategories     OrderCategory[]
  bankStatements      BankStatement[]
  bankStatementCategories BankStatementCategory[]
  bankTreeCategories  BankTreeCategory[]
  bankClassificationRules BankClassificationRule[]
  bankStatementTemplates BankStatementTemplate[]
  backupJobs             BackupJob[]
  companyAssets        CompanyAsset[]
  companyBackupConfig  CompanyBackupConfig?
  vatPlanningQuarters VatPlanningQuarter[]
  ocrSuppliers        OcrSupplier[]
  ocrItems            OcrItem[]
  ocrInvoices         OcrInvoice[]
  ocrPriceHistory     OcrPriceHistory[]
  ocrCorrectionRules  OcrCorrectionRule[]
  ocrExtractionLogs   OcrExtractionLog[]

  @@index([tenantId])
  @@map("companies")
}

/// سجل ضريبي تخطيطي معزول — لا يؤثر على القيود المحاسبية؛ يحفظ نموذج الإفصاح والتعديلات والدفع
model VatPlanningQuarter {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  companyId        String    @map("company_id")
  year             Int
  quarter          Int       // 1..4
  payload          Json      @default("{}")
  sourceSnapshot   Json?     @map("source_snapshot")
  paymentTarget    Decimal?  @map("payment_target") @db.Decimal(18, 4)
  notes            String?   @db.Text
  importedAt       DateTime? @map("imported_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, quarter])
  @@index([tenantId])
  @@index([companyId, year])
  @@map("vat_planning_quarters")
}

// ══════════════════════════════════════════════════
// النسخ الاحتياطي الذكي — سجل نسخ محلي + تكامل خارجي
// ══════════════════════════════════════════════════
model BackupJob {
  id                String    @id @default(cuid())
  tenantId          String?   @map("tenant_id")
  companyId         String?   @map("company_id")
  scope             String    // database_full | system_full | company_logical
  status            String    // pending | running | completed | failed | skipped_duplicate
  contentHash       String?   @map("content_hash")
  localRelativePath String?   @map("local_relative_path")
  sizeBytes         BigInt?   @map("size_bytes")
  durationMs        Int?      @map("duration_ms")
  report            Json?
  errorMessage      String?   @map("error_message")
  externalUploaded  Boolean   @default(false) @map("external_uploaded")
  externalError     String?   @map("external_error")
  duplicateOfJobId  String?   @map("duplicate_of_job_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  completedAt       DateTime? @map("completed_at")
  createdByUserId   String?   @map("created_by_user_id")
  /// رقم تسلسلي للعرض: لـ database_full عالمي، لـ company_logical لكل شركة ضمن المستأجر
  ordinal           Int?      @map("ordinal")
  verifiedAt        DateTime? @map("verified_at")
  verifyOk          Boolean?  @map("verify_ok")
  verifyError       String?   @map("verify_error") @db.Text

  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("BackupCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([companyId, createdAt])
  @@map("backup_jobs")
}

/// إعدادات النسخ التلقائي لقاعدة البيانات الكاملة — صف واحد (id = singleton)
model SystemBackupConfig {
  id               String   @id @default("singleton")
  enabled          Boolean  @default(false)
  scheduleHour     Int      @default(6) @map("schedule_hour")
  scheduleMinute   Int      @default(0) @map("schedule_minute")
  retentionCount   Int      @default(10) @map("retention_count")
  timezone         String   @default("Asia/Riyadh")
  lastRunDayRiyadh String?  @map("last_run_day_riyadh")
  /// رابط تطبيق ويب Google Apps Script للرفع (يغلب BACKUP_GDRIVE_SCRIPT_URL إن وُجد)
  gdriveScriptUrl  String?  @map("gdrive_script_url") @db.Text
  /// معرّف مجلد Drive أو رابط المجلد — يُمرَّر للسكربت كـ folderId
  gdriveFolderId   String?  @map("gdrive_folder_id") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("system_backup_config")
}

/// إعدادات النسخ التلقائي اليومي لشركة واحدة — لقطة منطقية (company_logical)
model CompanyBackupConfig {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  companyId        String   @unique @map("company_id")
  enabled          Boolean  @default(false)
  scheduleHour     Int      @default(6) @map("schedule_hour")
  scheduleMinute   Int      @default(0) @map("schedule_minute")
  retentionCount   Int      @default(5) @map("retention_count")
  timezone         String   @default("Asia/Riyadh")
  lastRunDayRiyadh String?  @map("last_run_day_riyadh")
  gdriveScriptUrl  String?  @map("gdrive_script_url") @db.Text
  gdriveFolderId   String?  @map("gdrive_folder_id") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("company_backup_config")
}

// تحليل كشوف الحساب — كشف واحد مع حركاته
model BankStatement {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  companyId        String   @map("company_id")
  fileName         String   @map("file_name")
  fileFormat       String   @map("file_format")   // excel | csv
  companyName      String   @map("company_name")  // اسم صاحب الحساب
  bankName         String   @map("bank_name")
  startDate        String?  @map("start_date")
  endDate          String?  @map("end_date")
  status           String   @default("mapping")   // uploading | mapping | analyzing | completed | failed
  headerRow        Int      @default(0)           @map("header_row")
  dataStartRow     Int      @default(0)           @map("data_start_row")
  dataEndRow       Int      @default(0)           @map("data_end_row")
  columnMapping    Json?    @map("column_mapping") // { dateCol, descCol, debitCol, creditCol, balanceCol }
  totalDeposits    Decimal  @default(0)           @map("total_deposits")
  totalWithdrawals Decimal  @default(0)           @map("total_withdrawals")
  transactionCount Int      @default(0)           @map("transaction_count")
  rawData          Json?    @map("raw_data")      // شبكة الملف كاملة (حتى حد الخادم) لإعادة الربط
  summaryJson      Json?    @map("summary_json") // opening/closing/by_category/pos_terminals (Base44)
  aiAnalysis       String?  @map("ai_analysis") @db.Text
  createdAt        DateTime @default(now())       @map("created_at")
  updatedAt        DateTime @updatedAt            @map("updated_at")

  company    Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions BankStatementTransaction[]

  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("bank_statements")
}

model BankStatementTransaction {
  id          String   @id @default(cuid())
  statementId String   @map("statement_id")
  txDate      String   @map("tx_date")
  description String  @default("")
  categoryId  String?  @map("category_id")
  debit       Decimal  @default(0)   @map("debit")
  credit      Decimal  @default(0)   @map("credit")
  balance     Decimal? @map("balance")
  reference   String?  @map("reference")
  note        String?  @map("note")
  sortOrder   Int      @default(0)    @map("sort_order")
  matchKeyword       String?  @map("match_keyword")
  classificationName String?  @map("classification_name")
  transactionType    String?  @map("transaction_type")
  manuallyClassified Boolean  @default(false) @map("manually_classified")

  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  category  BankStatementCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([statementId])
  @@map("bank_statement_transactions")
}

// فئات شجرية + كلمات مفتاحية (مطابقة BankCategory في Base44)
model BankTreeCategory {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  companyId         String   @map("company_id")
  name              String   @map("name")
  sortOrder         Int      @default(100) @map("sort_order")
  isActive          Boolean  @default(true) @map("is_active")
  transactionSide   String   @default("any") @map("transaction_side")
  transactionType   String?  @map("transaction_type")
  parentKeywords    Json     @map("parent_keywords")
  classifications   Json     @map("classifications")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([companyId])
  @@map("bank_tree_categories")
}

// قواعد تصنيف قديمة/بسيطة (مطابقة BankClassificationRule)
model BankClassificationRule {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  companyId         String   @map("company_id")
  keyword           String   @map("keyword")
  matchType         String   @default("contains") @map("match_type")
  categoryName      String   @map("category_name")
  transactionSide   String   @default("any") @map("transaction_side")
  transactionType   String?  @map("transaction_type")
  isActive          Boolean  @default(true) @map("is_active")
  priority          Int      @default(0) @map("priority")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([companyId])
  @@map("bank_classification_rules")
}

// قوالب أعمدة لكل بنك (مطابقة BankTemplate)
model BankStatementTemplate {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  companyId      String    @map("company_id")
  bankName       String    @map("bank_name")
  customerName   String?   @map("customer_name")
  headerRow      Int       @map("header_row")
  dataStartRow   Int       @map("data_start_row")
  dataEndRow     Int       @default(-1) @map("data_end_row")
  columnsJson    Json      @map("columns_json")
  dateFormat     String?   @map("date_format")
  sampleHeaders  Json      @map("sample_headers")
  isActive       Boolean   @default(true) @map("is_active")
  usageCount     Int       @default(0) @map("usage_count")
  lastUsedAt     DateTime? @map("last_used_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([companyId])
  @@map("bank_statement_templates")
}

model BankStatementCategory {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  color     String   @default("#6366f1")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  company      Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions BankStatementTransaction[]

  @@index([companyId])
  @@map("bank_statement_categories")
}

// الفترات المالية — قفل التسجيل في فترات مغلقة
model FiscalPeriod {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")     // RLS
  companyId   String   @map("company_id")
  nameAr      String   @map("name_ar")       // مثل: "يناير 2025"
  nameEn      String?  @map("name_en")
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  status      String   @default("open")       // open | closed | locked
  closedAt    DateTime? @map("closed_at")
  closedById  String?  @map("closed_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, startDate])
  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, status])
  @@map("fiscal_periods")
}

// مفتاح عدم التكرار — منع تنفيذ نفس العملية مرتين
model IdempotencyKey {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")     // RLS
  companyId    String   @map("company_id")
  keyHash      String   @map("key_hash")      // hash من (operationType + payload)
  resultJson   Json?    @map("result_json")   // نتيجة العملية المخزنة
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([companyId, keyHash])
  @@index([tenantId])
  @@index([companyId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ربط المستخدم بالشركات المسموح له بها داخل الـ Tenant
model UserCompany {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId],    references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("user_companies")
}

// ══════════════════════════════════════════════════
// TIER 4: OPERATIONAL DATA
// كل جدول يحمل tenantId + companyId للـ RLS
// tenantId = عزل على مستوى PostgreSQL
// companyId = تصفية على مستوى التطبيق
// ══════════════════════════════════════════════════

// ── جدول الموظفين — نواة نظام HR المتكامل ─────────
model Employee {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")        // RLS
  companyId          String   @map("company_id")
  employeeSerial     String   @map("employee_serial")  // الرقم الوظيفي (مثل MS-ST-001)
  name               String                            // الاسم الكامل
  nameEn             String?  @map("name_en")
  iqamaNumber        String?  @map("iqama_number")     // رقم الإقامة
  jobTitle           String?  @map("job_title")        // المسمى الوظيفي
  basicSalary        Decimal  @map("basic_salary")     @db.Decimal(18, 4)
  housingAllowance   Decimal  @default(0) @map("housing_allowance")    @db.Decimal(18, 4)
  transportAllowance Decimal  @default(0) @map("transport_allowance")  @db.Decimal(18, 4)
  otherAllowance     Decimal  @default(0) @map("other_allowance")      @db.Decimal(18, 4)
  workHours          String?  @map("work_hours")       // ساعات العمل (مثل: 8 ساعات يومياً)
  workSchedule       String?  @map("work_schedule")    // نظام الدوام (مثل: من الأحد إلى الخميس)
  joinDate           DateTime @map("join_date")        // أساس حساب نهاية الخدمة
  status             String   @default("active")       // active | terminated | on_leave
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt      @map("updated_at")

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices      Invoice[]
  ledgerEntries LedgerEntry[]
  payrollRuns   PayrollRunItem[]
  leaves        Leave[]
  residencies   EmployeeResidency[]
  documents     EmployeeDocument[]
  movements       EmployeeMovement[]
  customAllowances EmployeeCustomAllowance[]
  deductions      EmployeeDeduction[]
  leaveSalarySettlements LeaveSalarySettlement[]

  @@unique([companyId, employeeSerial])
  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, status])
  @@map("employees")
}

// ── مسيرة الرواتب (دفعة شهرية) ─────────────────────────────
model PayrollRun {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  companyId       String   @map("company_id")
  runNumber       String   @map("run_number")       // PR-2026-03
  payrollMonth    DateTime @map("payroll_month")    // أول يوم من الشهر
  totalAmount     Decimal  @map("total_amount")     @db.Decimal(18, 4)
  employeeCount   Int      @map("employee_count")
  status          String   @default("draft")        // draft | completed
  notes           String?
  /// عند الاعتماد: تسوية خصم السلف على فواتير السلف (يُمنع التكرار عند صرف المسيرة لاحقاً)
  advanceSettlementsAppliedAt DateTime? @map("advance_settlements_applied_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   PayrollRunItem[]
  /// توزيع صرف المسيرة على خزائن (مستوى المسيرة — فاتورة صرف واحدة عند الإصدار)
  runVaultSplits PayrollRunVault[]

  @@unique([companyId, runNumber])
  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, payrollMonth])
  @@map("payroll_runs")
}

model PayrollRunItem {
  id              String   @id @default(cuid())
  payrollRunId    String   @map("payroll_run_id")
  employeeId      String   @map("employee_id")
  grossSalary     Decimal  @map("gross_salary")     @db.Decimal(18, 4)
  allowancesAdd   Decimal  @default(0) @map("allowances_add")   @db.Decimal(18, 4)  // بدلات إضافية
  deductions      Decimal  @default(0) @map("deductions")      @db.Decimal(18, 4)  // خصومات (جزاءات وغيرها)
  advancesDeduct  Decimal  @default(0) @map("advances_deduct") @db.Decimal(18, 4) // خصم السلف
  netSalary       Decimal  @map("net_salary")       @db.Decimal(18, 4)
  notes           String?

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  vaultSplits PayrollRunItemVault[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payroll_run_items")
}

// توزيع الدفع على خزائن متعددة لكل بند في المسيرة
model PayrollRunItemVault {
  id              String   @id @default(cuid())
  payrollItemId   String   @map("payroll_item_id")
  vaultId         String   @map("vault_id")
  amount          Decimal  @map("amount")  @db.Decimal(18, 4)

  payrollItem PayrollRunItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  vault       Vault          @relation(fields: [vaultId], references: [id], onDelete: Restrict)

  @@unique([payrollItemId, vaultId])
  @@index([payrollItemId])
  @@map("payroll_run_item_vaults")
}

/// خزائن دفع مسيرة الرواتب (إجمالي المسيرة — ليس لكل موظف)
model PayrollRunVault {
  id           String   @id @default(cuid())
  payrollRunId String   @map("payroll_run_id")
  vaultId      String   @map("vault_id")
  amount       Decimal  @map("amount") @db.Decimal(18, 4)

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  vault      Vault      @relation(fields: [vaultId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, vaultId])
  @@index([payrollRunId])
  @@map("payroll_run_vaults")
}

// ── الإجازات ───────────────────────────────────────────────
model Leave {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  companyId       String   @map("company_id")
  employeeId      String   @map("employee_id")
  leaveType       String   @map("leave_type")       // annual | sick | unpaid | other
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  daysCount       Int      @map("days_count")
  status          String   @default("pending")       // pending | approved | rejected
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salarySettlement LeaveSalarySettlement?

  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, employeeId])
  @@index([companyId, startDate])
  @@map("leaves")
}

/// تسوية راتب تقويمية عند الموافقة على إجازة سنوية (صرف فوري؛ تُستبعد من مسيرة نهاية الشهر)
model LeaveSalarySettlement {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  companyId        String   @map("company_id")
  leaveId          String   @unique @map("leave_id")
  employeeId       String   @map("employee_id")
  payrollMonth     DateTime @map("payroll_month") // أول يوم من الشهر المعني
  invoiceId        String   @unique @map("invoice_id")
  grossAmount      Decimal  @map("gross_amount") @db.Decimal(18, 4)
  netAmount        Decimal  @map("net_amount") @db.Decimal(18, 4)
  calendarDaysPaid Int      @map("calendar_days_paid")
  daysInMonth      Int      @map("days_in_month")
  transactionDate  DateTime @map("transaction_date")
  createdAt        DateTime @default(now()) @map("created_at")

  leave    Leave    @relation(fields: [leaveId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([employeeId, payrollMonth])
  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, payrollMonth])
  @@map("leave_salary_settlements")
}

// ── الإقامات ───────────────────────────────────────────────
model EmployeeResidency {
  id                    String    @id @default(cuid())
  tenantId              String    @map("tenant_id")
  companyId             String    @map("company_id")
  employeeId            String    @map("employee_id")
  iqamaNumber           String    @map("iqama_number")
  issueDate             DateTime? @map("issue_date")
  expiryDate            DateTime  @map("expiry_date")
  status                String    @default("active")      // active | expired | renewed
  notes                 String?
  invoiceId             String?   @map("invoice_id")     // ربط بفاتورة الإقامة عند الإصدار
  residencyInvoiceAmount Decimal?  @map("residency_invoice_amount") @db.Decimal(18, 4)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt      @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, employeeId])
  @@index([companyId, expiryDate])
  @@map("employee_residencies")
}

// ── مستندات الموظف ────────────────────────────────────────
model EmployeeDocument {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  companyId       String   @map("company_id")
  employeeId      String   @map("employee_id")
  documentType    String   @map("document_type")    // contract | certificate | iqama | other
  fileName        String   @map("file_name")
  filePath        String?  @map("file_path")        // مسار التخزين أو رابط
  fileSize        Int?     @map("file_size")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, employeeId])
  @@map("employee_documents")
}

// ── سجل الترقيات والزيادات ─────────────────────────────
model EmployeeMovement {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  companyId       String   @map("company_id")
  employeeId      String   @map("employee_id")
  movementType    String   @map("movement_type")   // promotion | raise | other
  amount          Decimal? @map("amount")         @db.Decimal(18, 4)  // للزيادة
  previousValue   String?  @map("previous_value") // القيمة السابقة (مثل الراتب القديم)
  newValue        String?  @map("new_value")      // القيمة الجديدة
  effectiveDate   DateTime @map("effective_date")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, employeeId])
  @@map("employee_movements")
}

// ── بدلات مخصصة (إضافة/حذف) ─────────────────────────────
model EmployeeCustomAllowance {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  companyId       String   @map("company_id")
  employeeId      String   @map("employee_id")
  nameAr          String   @map("name_ar")
  amount          Decimal  @map("amount")  @db.Decimal(18, 4)
  createdAt       DateTime @default(now()) @map("created_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, employeeId])
  @@map("employee_custom_allowances")
}

// ── سجل الخصومات ───────────────────────────────────────
model EmployeeDeduction {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  companyId       String   @map("company_id")
  employeeId      String   @map("employee_id")
  deductionType   String   @map("deduction_type")  // advance | penalty | other
  amount          Decimal  @map("amount")  @db.Decimal(18, 4)
  transactionDate DateTime @map("transaction_date")
  notes           String?
  referenceId     String?  @map("reference_id")   // ربط بفاتورة سلفة إن وجدت
  createdAt       DateTime @default(now()) @map("created_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, employeeId])
  @@map("employee_deductions")
}

model Category {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")      // RLS
  companyId String   @map("company_id")
  accountId String?  @map("account_id")    // ربط بجدول الحسابات — للفئات المُظهرة في P&L
  code      String?  @map("code")          // كود تحليلي: أب مثل PUR-001، فرع مثل P1-1 أو E3-2
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  parentId  String?  @map("parent_id")
  type      String   @default("purchase")   // purchase | expense | sale | general
  icon      String?
  isActive  Boolean  @default(true)  @map("is_active")
  sortOrder Int      @default(0)     @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account      Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]   @relation("CategoryTree")
  suppliers    Supplier[]
  expenseLines ExpenseLine[]

  @@unique([companyId, code])
  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, parentId])
  @@index([accountId])
  @@map("categories")
}

model Supplier {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")      // RLS
  companyId          String   @map("company_id")
  nameAr             String   @map("name_ar")
  nameEn             String?  @map("name_en")
  phone              String?
  taxNumber          String?  @map("tax_number")
  categoryId         String?  @map("category_id")           // مشتريات | مصروفات (legacy)
  supplierCategoryId String?  @map("supplier_category_id")  // FK → Category
  isBookmarked       Boolean  @default(false) @map("is_bookmarked")
  isTaxRegistered    Boolean  @default(true)  @map("is_tax_registered")
  isDeleted          Boolean  @default(false) @map("is_deleted")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt      @map("updated_at")

  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierCategory Category?    @relation(fields: [supplierCategoryId], references: [id], onDelete: SetNull)
  invoices         Invoice[]
  expenseLines     ExpenseLine[]
  companyAssets    CompanyAsset[]

  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, isDeleted])
  @@map("suppliers")
}

// بند مصروف — هاتف 1، كهرب 1، إيجار محل — لكل بند سجل مدفوعات خاص
model ExpenseLine {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  companyId     String   @map("company_id")
  nameAr        String   @map("name_ar")         // "هاتف رقم 1"، "كهرباء الفرع 1"
  nameEn        String?  @map("name_en")
  kind          String   // fixed_expense | expense
  categoryId    String   @map("category_id")
  supplierId    String   @map("supplier_id")
  serviceNumber String?  @map("service_number")  // رقم الخدمة/العداد
  /// مبلغ مرجعي متوقع (مثلاً لكل دفعة) — يُقترَح عند تسجيل السداد ويُسمح بتعديله حسب allowPaymentAmountOverride
  referenceAmount            Decimal? @map("reference_amount") @db.Decimal(18, 2)
  allowPaymentAmountOverride Boolean  @default(true) @map("allow_payment_amount_override")
  /// إجمالي سنوي متوقع (مثلاً 120,000) — لاقتراح مبلغ كل دفعة مع installmentIntervalMonths
  annualTotalAmount          Decimal? @map("annual_total_amount") @db.Decimal(18, 2)
  /// فترة الدفع بالأشهر: 1،2،3،4،6،12 (يجب أن يقسم 12 بدون باقٍ)
  installmentIntervalMonths  Int?     @map("installment_interval_months")
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier  Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoices  Invoice[]

  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, kind])
  @@index([companyId, categoryId])
  @@index([companyId, supplierId])
  @@map("expense_lines")
}

model Account {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")      // RLS
  companyId String   @map("company_id")
  code      String
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  type      String   // asset | liability | equity | revenue | expense
  icon      String?  // أيقونة للعرض (مثل: 💵، 📦)
  taxExempt Boolean  @default(false) @map("tax_exempt")  // معفى من الضريبة افتراضياً
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vaults       Vault[]
  ledgerDebit  LedgerEntry[] @relation("DebitAccount")
  ledgerCredit LedgerEntry[] @relation("CreditAccount")
  categories   Category[]

  @@unique([companyId, code])
  @@index([tenantId])
  @@index([companyId])
  @@map("accounts")
}

model Vault {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")      // RLS
  companyId      String   @map("company_id")
  accountId      String   @map("account_id")
  nameAr         String   @map("name_ar")
  nameEn         String?  @map("name_en")
  type           String   // cash | bank | app
  isActive       Boolean  @default(true)  @map("is_active")
  isArchived     Boolean  @default(false) @map("is_archived")
  isSalesChannel Boolean  @default(false) @map("is_sales_channel")
  /// عند false تُخفى من كل قوائم السداد في الواجهة والـ API (مصاريف، HR، فواتير صرف، …)
  showAsPaymentMethod Boolean @default(true) @map("show_as_payment_method")
  paymentMethod  String?  @map("payment_method")
  notes          String?
  /// ترتيب العرض في الخزائن، قنوات المبيعات، وقوائم السداد (الأصغر يظهر أولاً)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account       Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]
  invoices      Invoice[]
  salesChannels DailySalesChannel[]
  payrollItemVaults PayrollRunItemVault[]
  payrollRunVaults  PayrollRunVault[]
  invoiceVaultAllocations InvoiceVaultAllocation[]

  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, isArchived])
  @@index([companyId, sortOrder])
  @@map("vaults")
}

/// توزيع سداد فاتورة صرف واحدة على أكثر من خزنة (قيد لكل جزء)
model InvoiceVaultAllocation {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  invoiceId String   @map("invoice_id")
  vaultId   String   @map("vault_id")
  amount    Decimal  @map("amount") @db.Decimal(18, 4)
  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  vault   Vault   @relation(fields: [vaultId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([vaultId])
  @@map("invoice_vault_allocations")
}

model Invoice {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")       // RLS
  companyId       String    @map("company_id")
  supplierId      String?   @map("supplier_id")     // اختياري — null للرواتب/السلفيات
  employeeId      String?   @map("employee_id")     // مرتبط بالموظف (راتب/سلفية)
  expenseLineId   String?   @map("expense_line_id") // ربط ببند المصروف (fixed/variable)
  categoryId      String?   @map("category_id")     // فئة المصروف — للفلترة والتقارير
  invoiceNumber   String    @map("invoice_number")
  supplierInvoiceNumber String? @map("supplier_invoice_number")  // رقم الفاتورة من المورد (غير السريل الداخلي)
  kind            String    // purchase | expense | salary | advance | hr_expense | fixed_expense
  totalAmount     Decimal   @map("total_amount")     @db.Decimal(18, 4)
  netAmount       Decimal   @map("net_amount")       @db.Decimal(18, 4)
  taxAmount       Decimal   @map("tax_amount")       @db.Decimal(18, 4)
  transactionDate DateTime  @map("transaction_date")
  invoiceDate     DateTime? @map("invoice_date")     // تاريخ الفاتورة الأصلية
  vaultId         String?   @map("vault_id")
  paymentMethodId String?   @map("payment_method_id")
  batchId         String?   @map("batch_id")
  notes           String?  // ملاحظة / تفاصيل — اسم الموظف، الشهر، تفاصيل فواتير حكومية
  /// مسار ملف الإيصال/المسح الضوئي على الخادم — لا يُعرَض للعميل في JSON (يُزال عند الإرجاع)
  attachmentPath         String? @map("attachment_path")
  /// الاسم الأصلي للعرض والتحميل
  attachmentOriginalName String? @map("attachment_original_name")
  settledAt         DateTime? @map("settled_at")        // للسلف: تاريخ التسديد (خصم من راتب أو سداد)
  settledAmount     Decimal?  @map("settled_amount")    @db.Decimal(18, 4) // للسلف: المبلغ المسدد
  installmentCount  Int?      @map("installment_count") // للسلف بالأقساط: عدد الدفعات
  installmentAmount Decimal?  @map("installment_amount") @db.Decimal(18, 4) // للسلف بالأقساط: مبلغ القسط الواحد
  /// للمصاريف الثابتة: سنة التغطية المحاسبية للدفعة
  expenseCoverageYear       Int? @map("expense_coverage_year")
  /// للمصاريف الثابتة: الربع 1–4 (إن وُجد يُشتق شهر البداية تلقائياً)
  expenseCoverageQuarter    Int? @map("expense_coverage_quarter")
  /// للمصاريف الثابتة: شهر بداية التغطية 1–12 (وضع الأشهر)
  expenseCoverageMonthStart Int? @map("expense_coverage_month_start")
  /// للمصاريف الثابتة: عدد الأشهر المغطاة بهذه الدفعة
  expenseMonthsCovered      Int? @map("expense_months_covered")
  /// متابعة الضمان من المشتريات — بدون مدة هنا؛ تُكمَّل في قسم الضمان
  warrantyFollowUp     Boolean  @default(false) @map("warranty_follow_up")
  /// أُنجز إكمال بيانات الضمان من قسم الضمان (تُخرج من قائمة الانتظار)
  warrantyFollowUpDone Boolean  @default(false) @map("warranty_follow_up_done")
  dailySalesSummaryId String? @unique @map("daily_sales_summary_id")  // للمبيعات: ربط بملخص المبيعات اليومي (واحد لواحد)
  status          String   @default("active")       // active | cancelled
  entryDate       DateTime @map("entry_date")       // توقيت السيرفر — غير قابل للتعديل
  /// مستخدم النظام الذي أنشأ السجل (فاتورة صرف/مبيعات)
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  company       Company             @relation(fields: [companyId],  references: [id], onDelete: Cascade)
  supplier      Supplier?           @relation(fields: [supplierId],  references: [id], onDelete: Restrict)
  vault         Vault?              @relation(fields: [vaultId],     references: [id], onDelete: SetNull)
  createdByUser User?               @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  employee      Employee?           @relation(fields: [employeeId],  references: [id], onDelete: SetNull)
  expenseLine   ExpenseLine?        @relation(fields: [expenseLineId], references: [id], onDelete: SetNull)
  dailySalesSummary DailySalesSummary? @relation(fields: [dailySalesSummaryId], references: [id], onDelete: SetNull)
  vaultAllocations InvoiceVaultAllocation[]
  leaveSalarySettlement LeaveSalarySettlement?
  companyAssets    CompanyAsset[]
  ocrInvoicesLinkedFromOcr OcrInvoice[] @relation("OcrInvoiceLinkedPurchase")

  @@unique([companyId, invoiceNumber])
  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, transactionDate])
  @@index([companyId, status])
  @@index([companyId, kind, status, transactionDate])
  @@index([companyId, employeeId])
  @@index([companyId, expenseLineId])
  @@index([companyId, categoryId])
  @@index([companyId, batchId])
  @@index([companyId, kind, warrantyFollowUp, warrantyFollowUpDone])
  @@index([companyId, createdByUserId])
  @@map("invoices")
}

/// سجل أصول تشغيلي (بدون إهلاك) — ضمان، مدة، ربط اختياري بفاتورة/مورد
model CompanyAsset {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  companyId           String    @map("company_id")
  nameAr              String    @map("name_ar")
  nameEn              String?   @map("name_en")
  serialNumber        String?   @map("serial_number")
  location            String?
  purchaseDate        DateTime? @map("purchase_date") @db.Date
  acquisitionCost     Decimal?  @map("acquisition_cost") @db.Decimal(18, 2)
  supplierId          String?   @map("supplier_id")
  invoiceId           String?   @map("invoice_id")
  warrantyDescription String?   @map("warranty_description") @db.Text
  warrantyMonths      Int?      @map("warranty_months")
  warrantyStartDate   DateTime? @map("warranty_start_date") @db.Date
  warrantyEndDate     DateTime? @map("warranty_end_date") @db.Date
  notes               String?   @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  warrantyLines CompanyAssetWarrantyLine[]

  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, purchaseDate])
  @@index([companyId, warrantyEndDate])
  @@map("company_assets")
}

/// تفاصيل أصناف/بنود ضمان مرتبطة بأصل (إدخال من قسم الضمان)
model CompanyAssetWarrantyLine {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  companyId      String    @map("company_id")
  companyAssetId String    @map("company_asset_id")
  sortOrder      Int       @default(0) @map("sort_order")
  nameAr         String    @map("name_ar")
  nameEn         String?   @map("name_en")
  serialNumber   String?   @map("serial_number")
  quantity       Decimal?  @db.Decimal(18, 4)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  companyAsset CompanyAsset @relation(fields: [companyAssetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([companyId])
  @@index([companyAssetId])
  @@map("company_asset_warranty_lines")
}

model DailySalesSummary {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")      // RLS
  companyId       String   @map("company_id")
  summaryNumber   String   @map("summary_number")
  transactionDate DateTime @map("transaction_date")
  customerCount   Int      @default(0)   @map("customer_count")
  cashOnHand      Decimal  @default(0)   @map("cash_on_hand")  @db.Decimal(18, 4)
  totalAmount     Decimal  @default(0)   @map("total_amount")  @db.Decimal(18, 4)
  notes           String?
  status          String   @default("active")
  createdById     String?  @map("created_by_id")    // ✅ بصمة المستخدم — مرتبط بـ User
  entryDate       DateTime @map("entry_date")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  company      Company  @relation(fields: [companyId],   references: [id], onDelete: Cascade)
  createdBy    User?    @relation("SalesCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  channels     DailySalesChannel[]
  saleInvoice  Invoice?  // فاتورة مبيعات مرتبطة (للعرض الموحد في قسم الفواتير)

  @@unique([companyId, summaryNumber])
  @@index([tenantId])
  @@index([companyId, transactionDate])
  @@map("daily_sales_summaries")
}

model DailySalesChannel {
  id        String  @id @default(cuid())
  summaryId String  @map("summary_id")
  vaultId   String  @map("vault_id")
  amount    Decimal @default(0) @db.Decimal(18, 4)

  summary DailySalesSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  vault   Vault              @relation(fields: [vaultId],   references: [id], onDelete: Restrict)

  @@unique([summaryId, vaultId])
  @@map("daily_sales_channels")
}

// جدول الحركات الموحد (القيد المزدوج)
model LedgerEntry {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")      // RLS
  companyId       String   @map("company_id")
  debitAccountId  String   @map("debit_account_id")
  creditAccountId String   @map("credit_account_id")
  amount          Decimal  @db.Decimal(18, 4)
  transactionDate DateTime @map("transaction_date")
  entryDate       DateTime @map("entry_date")
  referenceType   String   @map("reference_type")  // invoice | sale | transfer | expense | salary | advance
  referenceId     String   @map("reference_id")
  vaultId         String?  @map("vault_id")
  employeeId      String?  @map("employee_id")     // مرتبط بالموظف (راتب/سلفية)
  createdById     String?  @map("created_by_id")   // ✅ بصمة المستخدم
  status          String   @default("active")       // active | cancelled
  createdAt       DateTime @default(now()) @map("created_at")

  company       Company   @relation(fields: [companyId],       references: [id], onDelete: Cascade)
  debitAccount  Account   @relation("DebitAccount",  fields: [debitAccountId],  references: [id], onDelete: Restrict)
  creditAccount Account   @relation("CreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)
  vault         Vault?    @relation(fields: [vaultId],    references: [id], onDelete: SetNull)
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdBy     User?     @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, transactionDate])
  @@index([companyId, status, transactionDate])
  @@index([companyId, entryDate])
  @@index([referenceType, referenceId])
  @@index([vaultId])
  @@index([companyId, employeeId])
  @@map("ledger_entries")
}

// سجل التدقيق — يُسجّل بصمة المستخدم الحقيقية على كل حركة
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")      // RLS
  companyId String   @map("company_id")
  userId    String?  @map("user_id")        // ✅ بصمة المستخدم — لا يكون null عند الحفظ
  action    String   // create | update | delete | cancel
  entity    String   // invoice | ledger_entry | user | company | ...
  entityId  String   @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId],    references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, entity, entityId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

// ── الطلبات (قسم داخلي — لا ربط محاسبي) ─────────────────────
model OrderCategory {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  companyId String   @map("company_id")
  nameAr    String   @map("name_ar")   // خضروات، لحوم، مشروبات
  nameEn    String?  @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products OrderProduct[]

  @@index([tenantId])
  @@index([companyId])
  @@map("order_categories")
}

model OrderProduct {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  companyId   String   @map("company_id")
  categoryId  String?  @map("category_id")
  nameAr      String   @map("name_ar")
  nameEn      String?  @map("name_en")
  unit        String   @default("piece")  // piece | kg | box | dozen — افتراضي عند عدم وجود variants
  sizes       String?  @map("sizes")      // أحجام متاحة: صغير,وسط,كبير (للتوافق مع الإصدارات القديمة)
  packaging   String?  @map("packaging")  // التغليف (للتوافق مع الإصدارات القديمة)
  lastPrice   Decimal  @default(0) @map("last_price") @db.Decimal(18, 4)  // سعر افتراضي عند عدم وجود variants
  variants    Json?    @map("variants")   // [{size,packaging,unit,lastPrice},...] — تركيبات متعددة بأسعار
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category OrderCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, categoryId])
  @@map("order_products")
}

model Order {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  companyId       String   @map("company_id")
  orderNumber     String   @map("order_number")   // ORD-20260315-001
  orderDate       DateTime @map("order_date")
  orderType       String   @map("order_type")    // external | internal
  pettyCashAmount Decimal? @map("petty_cash_amount") @db.Decimal(18, 4)  // للخارجي فقط
  totalAmount     Decimal  @map("total_amount")  @db.Decimal(18, 4)
  notes           String?
  status          String   @default("active") @map("status")  // active | cancelled
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   OrderItem[]

  @@unique([companyId, orderNumber])
  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, orderDate])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  size       String?  @map("size")       // الحجم المختار
  packaging  String?  @map("packaging")  // التغليف المختار
  unit       String?  @map("unit")       // الوحدة المختارة (piece|kg|box|dozen)
  quantity   Decimal  @db.Decimal(18, 4)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(18, 4)
  amount     Decimal  @db.Decimal(18, 4)

  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product OrderProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ══════════════════════════════════════════════════
// OCR INVOICES — قسم استخراج الفواتير التجريبي
// معزول تماماً عن باقي النظام بـ ocr_ prefix
// ══════════════════════════════════════════════════

model OcrSupplier {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  companyId   String   @map("company_id")
  nameAr      String   @map("name_ar")
  nameEn      String?  @map("name_en")
  taxNumber   String?  @map("tax_number")
  phone       String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aliases         OcrSupplierAlias[]
  invoices        OcrInvoice[]
  correctionRules OcrCorrectionRule[]
  priceHistory    OcrPriceHistory[]
  extractionLogs  OcrExtractionLog[]

  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
  @@map("ocr_suppliers")
}

model OcrSupplierAlias {
  id         String   @id @default(cuid())
  supplierId String   @map("supplier_id")
  alias      String
  language   String   @default("ar")
  addedBy    String   @default("support") @map("added_by")
  createdAt  DateTime @default(now()) @map("created_at")

  supplier OcrSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("ocr_supplier_aliases")
}

model OcrItem {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  companyId String   @map("company_id")
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  category  String?
  unitType  String?  @map("unit_type")
  hasSizes  Boolean  @default(false) @map("has_sizes") // هل لهذا الصنف أحجام متعددة؟
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aliases      OcrItemAlias[]
  lines        OcrInvoiceLine[]
  priceHistory OcrPriceHistory[]

  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
  @@map("ocr_items")
}

model OcrItemAlias {
  id        String   @id @default(cuid())
  itemId    String   @map("item_id")
  alias     String
  language  String   @default("ar")
  addedBy   String   @default("support") @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")

  item OcrItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("ocr_item_aliases")
}

model OcrInvoice {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  companyId     String    @map("company_id")
  supplierId    String?   @map("supplier_id")
  invoiceNumber String?   @map("invoice_number")
  invoiceDate   DateTime? @map("invoice_date")
  subtotalAmount Decimal?  @map("subtotal_amount") @db.Decimal(14, 2)
  totalAmount    Decimal?  @map("total_amount")    @db.Decimal(14, 2)
  vatAmount      Decimal?  @map("vat_amount")      @db.Decimal(14, 2)
  imageUrl      String?   @map("image_url")
  rawExtraction Json?     @map("raw_extraction")
  /// queued | extracting | pending_review | extraction_failed | pending | confirmed | rejected
  status        String    @default("pending")
  notes         String?
  submittedByUserId       String?  @map("submitted_by_user_id")
  extractionError         String?  @map("extraction_error") @db.Text
  linkedPurchaseInvoiceId String?  @map("linked_purchase_invoice_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt      @map("updated_at")

  company                 Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier                OcrSupplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  submittedBy             User?          @relation("OcrInvoiceSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  linkedPurchaseInvoice   Invoice?       @relation("OcrInvoiceLinkedPurchase", fields: [linkedPurchaseInvoiceId], references: [id], onDelete: SetNull)
  lines    OcrInvoiceLine[]

  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
  @@index([supplierId])
  @@map("ocr_invoices")
}

model OcrInvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String   @map("invoice_id")
  itemId      String?  @map("item_id")
  rawName     String   @map("raw_name")   // الاسم الكامل كما في الفاتورة
  nameAr      String?  @map("name_ar")    // الجزء العربي من الاسم
  nameEn      String?  @map("name_en")    // الجزء الإنجليزي من الاسم
  size        String?                     // الحجم مثل "700" أو "2"
  sizeUnit    String?  @map("size_unit")  // وحدة الحجم مثل "g" أو "L"
  quantity    Decimal? @db.Decimal(10, 3)
  unitPrice   Decimal? @map("unit_price")  @db.Decimal(14, 2)
  totalPrice  Decimal? @map("total_price") @db.Decimal(14, 2)
  confidence  Float    @default(0)
  matchStatus String   @default("pending") @map("match_status") // pending | matched | new | rejected
  createdAt   DateTime @default(now()) @map("created_at")

  invoice OcrInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    OcrItem?   @relation(fields: [itemId],    references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([itemId])
  @@map("ocr_invoice_lines")
}

model OcrPriceHistory {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  companyId   String   @map("company_id")
  itemId      String   @map("item_id")
  supplierId  String   @map("supplier_id")
  price       Decimal  @db.Decimal(14, 2)
  size        String?                    // الحجم للتتبع المنفصل لكل حجم
  sizeUnit    String?  @map("size_unit")
  invoiceDate DateTime @map("invoice_date")
  invoiceId   String?  @map("invoice_id")
  createdAt   DateTime @default(now()) @map("created_at")

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item     OcrItem     @relation(fields: [itemId],     references: [id], onDelete: Cascade)
  supplier OcrSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
  @@index([itemId])
  @@index([supplierId])
  @@map("ocr_price_history")
}

model OcrCorrectionRule {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  companyId   String   @map("company_id")
  entityType  String   @map("entity_type")  // supplier | item
  supplierId  String?  @map("supplier_id")  // supplier-scoped (null = global)
  wrongText   String   @map("wrong_text")
  correctText String   @map("correct_text")
  occurrences Int      @default(1)
  status      String   @default("pending")  // pending | confirmed | rejected
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier OcrSupplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
  @@index([supplierId])
  @@map("ocr_correction_rules")
}

model OcrExtractionLog {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  companyId     String   @map("company_id")
  entityType    String   @map("entity_type")  // supplier | item
  supplierId    String?  @map("supplier_id")
  extractedText String   @map("extracted_text")
  normalizedText String? @map("normalized_text")
  resolvedToId  String?  @map("resolved_to_id")
  resolvedText  String?  @map("resolved_text")
  confidence    Float    @default(0)
  occurrences   Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier OcrSupplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
  @@index([supplierId])
  @@map("ocr_extraction_logs")
}
