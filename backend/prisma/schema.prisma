generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // shadowDatabaseUrl = env("SHADOW_DATABASE_URL") // uncomment when using prisma migrate
  // âڑ ï¸ڈ ظ„ط§ طھط³طھط®ط¯ظ… `prisma db push --force-reset` ط¹ظ„ظ‰ ظ‚ط§ط¹ط¯ط© ط§ظ„ط¨ظٹط§ظ†ط§طھ ط§ظ„ط¥ظ†طھط§ط¬ظٹط© â€” ظٹظ…ط­ظˆ ط§ظ„ط¨ظٹط§ظ†ط§طھ ظƒط§ظ…ظ„ط©
  // ط¨ط¯ظ„ط§ظ‹ ظ…ظ† db push: ط§ط³طھط®ط¯ظ… `prisma migrate dev` ظ„ط¥ظ†ط´ط§ط، ظ…ظ„ظپ migration ط¢ظ…ظ†
}

// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
// TIER 1: TENANT (ط§ظ„ظ…ظ†ط¸ظ…ط© / ط§ظ„ط§ط´طھط±ط§ظƒ)
// ط§ظ„ط·ط¨ظ‚ط© ط§ظ„ط¹ظ„ظٹط§ â€” Tenant ظٹظ…ظ„ظƒ Companies
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
model Tenant {
  id          String   @id @default(cuid())
  name        String                           // ط§ط³ظ… ط§ظ„ظ…ظ†ط¸ظ…ط© (ظ…ط«ظ„: ظ…ط¬ظ…ظˆط¹ط© ط£ط¨ظˆ ظ…ط³ط¹ظˆط¯)
  slug        String   @unique                 // ظ…ط¹ط±ظ‘ظپ URL ظپط±ظٹط¯ (abumasoud-group)
  plan        String   @default("starter")     // starter | professional | enterprise
  isActive    Boolean  @default(true)  @map("is_active")
  maxCompanies Int     @default(5)     @map("max_companies")  // ط­ط¯ ط§ظ„ط´ط±ظƒط§طھ ط­ط³ط¨ ط§ظ„ط®ط·ط©
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  companies  Company[]
  users      User[]
  backupJobs BackupJob[]
  companyBackupConfigs CompanyBackupConfig[]

  @@map("tenants")
}

// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
// TIER 2: AUTH & PERMISSIONS
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
model Role {
  id                  String   @id @default(cuid())
  name                String   @unique
  nameAr              String?  @map("name_ar")
  description         String?
  permissions         String[] @default([])
  /// ط¢ط®ط± ظ…ط¬ظ…ظˆط¹ط© طµظ„ط§ط­ظٹط§طھ seed ط·ظڈط¨ظ‘ظ‚طھ ط¹ظ„ظ‰ ظ‡ط°ط§ ط§ظ„ط¯ظˆط± â€” طھظڈط³طھط®ط¯ظ… ظ„ط§ظƒطھط´ط§ظپ ط§ظ„طµظ„ط§ط­ظٹط§طھ ط§ظ„ط¬ط¯ظٹط¯ط© ظپط¹ظ„ط§ظ‹ ط¯ظˆظ† ط¥ط¹ط§ط¯ط© ظ…ط§ ط­ط°ظپظ‡ ط§ظ„ظ…ط¯ظٹط±
  lastSeedPermissions String[] @default([]) @map("last_seed_permissions")
  isSystem            Boolean  @default(false) @map("is_system")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt      @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")          // âڑ ï¸ڈ ط¥ظ„ط²ط§ظ…ظٹ â€” ط§ظ„ظ…ط³طھط®ط¯ظ… ظٹظ†طھظ…ظٹ ظ„ظ€ Tenant ظˆط§ط­ط¯
  email           String    @unique
  passwordHash    String    @map("password_hash")
  nameAr          String?   @map("name_ar")
  nameEn          String?   @map("name_en")
  roleId          String    @map("role_id")
  preferredLang   String    @default("ar")  @map("preferred_lang")
  isActive        Boolean   @default(true)  @map("is_active")
  lastActivityAt  DateTime? @map("last_activity_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt      @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId],  references: [id], onDelete: Cascade)
  role          Role          @relation(fields: [roleId],    references: [id], onDelete: Restrict)
  userCompanies UserCompany[]
  ledgerEntries LedgerEntry[] @relation("CreatedBy")
  auditLogs     AuditLog[]
  salesSummaries DailySalesSummary[] @relation("SalesCreatedBy")
  backupJobsCreated BackupJob[] @relation("BackupCreatedBy")
  invoicesCreated Invoice[] @relation("InvoiceCreatedBy")
  staffOrders          StaffOrder[]

  @@index([tenantId])
  @@map("users")
}

// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
// TIER 3: COMPANY (ط§ظ„ط´ط±ظƒط© â€” طھط­طھ Tenant)
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
model Company {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")              // âڑ ï¸ڈ ط¥ظ„ط²ط§ظ…ظٹ â€” RLS ظٹط³طھط®ط¯ظ…ظ‡
  nameAr     String   @map("name_ar")
  nameEn     String?  @map("name_en")
  logoUrl    String?  @map("logo_url")
  phone      String?
  address    String?
  taxNumber  String?  @map("tax_number")
  email      String?
  isArchived Boolean  @default(false) @map("is_archived")
  vatEnabledForSales Boolean @default(false) @map("vat_enabled_for_sales")
  vatRatePercent     Decimal  @default(15)   @map("vat_rate_percent") @db.Decimal(5, 2)
  salesShiftsEnabled Boolean  @default(false) @map("sales_shifts_enabled")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt      @map("updated_at")

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userCompanies       UserCompany[]
  suppliers           Supplier[]
  vaults              Vault[]
  accounts            Account[]
  invoices            Invoice[]
  ledgerEntries       LedgerEntry[]
  auditLogs           AuditLog[]
  dailySalesSummaries DailySalesSummary[]
  categories          Category[]
  employees           Employee[]
  payrollRuns         PayrollRun[]
  leaves              Leave[]
  employeeResidencies EmployeeResidency[]
  employeeDocuments   EmployeeDocument[]
  employeeMovements   EmployeeMovement[]
  employeeCustomAllowances EmployeeCustomAllowance[]
  employeeDeductions  EmployeeDeduction[]
  fiscalPeriods       FiscalPeriod[]
  expenseLines        ExpenseLine[]
  orders              Order[]
  orderProducts       OrderProduct[]
  orderCategories     OrderCategory[]
  orderSections       OrderSection[]
  staffOrders         StaffOrder[]
  bankStatements      BankStatement[]
  bankStatementCategories BankStatementCategory[]
  bankTreeCategories  BankTreeCategory[]
  bankClassificationRules BankClassificationRule[]
  bankStatementTemplates BankStatementTemplate[]
  backupJobs             BackupJob[]
  companyAssets        CompanyAsset[]
  companyBackupConfig  CompanyBackupConfig?
  companyInsightSettings CompanyInsightSettings?
  vatPlanningQuarters VatPlanningQuarter[]
  dashboardCalendarData DashboardCalendarData[]

  @@index([tenantId])
  @@map("companies")
}

/// ط³ط¬ظ„ ط¶ط±ظٹط¨ظٹ طھط®ط·ظٹط·ظٹ ظ…ط¹ط²ظˆظ„ â€” ظ„ط§ ظٹط¤ط«ط± ط¹ظ„ظ‰ ط§ظ„ظ‚ظٹظˆط¯ ط§ظ„ظ…ط­ط§ط³ط¨ظٹط©ط› ظٹط­ظپط¸ ظ†ظ…ظˆط°ط¬ ط§ظ„ط¥ظپطµط§ط­ ظˆط§ظ„طھط¹ط¯ظٹظ„ط§طھ ظˆط§ظ„ط¯ظپط¹
model VatPlanningQuarter {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  companyId        String    @map("company_id")
  year             Int
  quarter          Int       // 1..4
  payload          Json      @default("{}")
  sourceSnapshot   Json?     @map("source_snapshot")
  paymentTarget    Decimal?  @map("payment_target") @db.Decimal(18, 4)
  notes            String?   @db.Text
  /// ط§ط¹طھظ…ط§ط¯ ط§ظ„طھظ‚ط¯ظٹظ… ط§ظ„ط±ط³ظ…ظٹ ظپظٹ ط³ط¬ظ„ HAJRI (ظٹظ…ظƒظ† ط¥ط¹ط§ط¯ط© ظپطھط­ ط§ظ„طھط­ط±ظٹط± ظ„ط§ط­ظ‚ط§ظ‹)
  filingSubmitted  Boolean   @default(false) @map("filing_submitted")
  importedAt       DateTime? @map("imported_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, quarter])
  @@index([tenantId])
  @@index([companyId, year])
  @@map("vat_planning_quarters")
}

// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
// ط§ظ„ظ†ط³ط® ط§ظ„ط§ط­طھظٹط§ط·ظٹ ط§ظ„ط°ظƒظٹ â€” ط³ط¬ظ„ ظ†ط³ط® ظ…ط­ظ„ظٹ + طھظƒط§ظ…ظ„ ط®ط§ط±ط¬ظٹ
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
model BackupJob {
  id                String    @id @default(cuid())
  tenantId          String?   @map("tenant_id")
  companyId         String?   @map("company_id")
  scope             String    // database_full | system_full | company_logical
  status            String    // pending | running | completed | failed | skipped_duplicate
  contentHash       String?   @map("content_hash")
  localRelativePath String?   @map("local_relative_path")
  sizeBytes         BigInt?   @map("size_bytes")
  durationMs        Int?      @map("duration_ms")
  report            Json?
  errorMessage      String?   @map("error_message")
  externalUploaded  Boolean   @default(false) @map("external_uploaded")
  externalError     String?   @map("external_error")
  duplicateOfJobId  String?   @map("duplicate_of_job_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  completedAt       DateTime? @map("completed_at")
  createdByUserId   String?   @map("created_by_user_id")
  /// ط±ظ‚ظ… طھط³ظ„ط³ظ„ظٹ ظ„ظ„ط¹ط±ط¶: ظ„ظ€ database_full ط¹ط§ظ„ظ…ظٹطŒ ظ„ظ€ company_logical ظ„ظƒظ„ ط´ط±ظƒط© ط¶ظ…ظ† ط§ظ„ظ…ط³طھط£ط¬ط±
  ordinal           Int?      @map("ordinal")
  verifiedAt        DateTime? @map("verified_at")
  verifyOk          Boolean?  @map("verify_ok")
  verifyError       String?   @map("verify_error") @db.Text

  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("BackupCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([companyId, createdAt])
  @@map("backup_jobs")
}

/// ط¥ط¹ط¯ط§ط¯ط§طھ ط§ظ„ظ†ط³ط® ط§ظ„طھظ„ظ‚ط§ط¦ظٹ ظ„ظ‚ط§ط¹ط¯ط© ط§ظ„ط¨ظٹط§ظ†ط§طھ ط§ظ„ظƒط§ظ…ظ„ط© â€” طµظپ ظˆط§ط­ط¯ (id = singleton)
model SystemBackupConfig {
  id               String   @id @default("singleton")
  enabled          Boolean  @default(false)
  scheduleHour     Int      @default(6) @map("schedule_hour")
  scheduleMinute   Int      @default(0) @map("schedule_minute")
  retentionCount   Int      @default(10) @map("retention_count")
  timezone         String   @default("Asia/Riyadh")
  lastRunDayRiyadh String?  @map("last_run_day_riyadh")
  /// ط±ط§ط¨ط· طھط·ط¨ظٹظ‚ ظˆظٹط¨ Google Apps Script ظ„ظ„ط±ظپط¹ (ظٹط؛ظ„ط¨ BACKUP_GDRIVE_SCRIPT_URL ط¥ظ† ظˆظڈط¬ط¯)
  gdriveScriptUrl  String?  @map("gdrive_script_url") @db.Text
  /// ظ…ط¹ط±ظ‘ظپ ظ…ط¬ظ„ط¯ Drive ط£ظˆ ط±ط§ط¨ط· ط§ظ„ظ…ط¬ظ„ط¯ â€” ظٹظڈظ…ط±ظ‘ظژط± ظ„ظ„ط³ظƒط±ط¨طھ ظƒظ€ folderId
  gdriveFolderId   String?  @map("gdrive_folder_id") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("system_backup_config")
}

/// ط¥ط¹ط¯ط§ط¯ط§طھ ط§ظ„ظ†ط³ط® ط§ظ„طھظ„ظ‚ط§ط¦ظٹ ط§ظ„ظٹظˆظ…ظٹ ظ„ط´ط±ظƒط© ظˆط§ط­ط¯ط© â€” ظ„ظ‚ط·ط© ظ…ظ†ط·ظ‚ظٹط© (company_logical)
model CompanyBackupConfig {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  companyId        String   @unique @map("company_id")
  enabled          Boolean  @default(false)
  scheduleHour     Int      @default(6) @map("schedule_hour")
  scheduleMinute   Int      @default(0) @map("schedule_minute")
  retentionCount   Int      @default(5) @map("retention_count")
  timezone         String   @default("Asia/Riyadh")
  lastRunDayRiyadh String?  @map("last_run_day_riyadh")
  gdriveScriptUrl  String?  @map("gdrive_script_url") @db.Text
  gdriveFolderId   String?  @map("gdrive_folder_id") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("company_backup_config")
}

/// ط­ط¯ظˆط¯ طھظ†ط¨ظٹظ‡ط§طھ ط§ظ„ط±ط¤ظ‰ ط§ظ„ظ…ط§ظ„ظٹط© ظ„ظƒظ„ ط´ط±ظƒط© â€” ط§ظ„ظ…ط±ط­ظ„ط© ط£: طھط®ط²ظٹظ† ظپظ‚ط· (ط¨ط¯ظˆظ† ط±ط¨ط· ط³ظ„ظˆظƒ ط§ظ„ط¥ظ†طھط§ط¬ ط¨ط¹ط¯)
model CompanyInsightSettings {
  id          String   @id @default(cuid())
  companyId   String   @unique @map("company_id")
  thresholds  Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_insight_settings")
}

// طھط­ظ„ظٹظ„ ظƒط´ظˆظپ ط§ظ„ط­ط³ط§ط¨ â€” ظƒط´ظپ ظˆط§ط­ط¯ ظ…ط¹ ط­ط±ظƒط§طھظ‡
model BankStatement {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  companyId        String   @map("company_id")
  fileName         String   @map("file_name")
  fileFormat       String   @map("file_format")   // excel | csv
  companyName      String   @map("company_name")  // ط§ط³ظ… طµط§ط­ط¨ ط§ظ„ط­ط³ط§ط¨
  bankName         String   @map("bank_name")
  startDate        String?  @map("start_date")
  endDate          String?  @map("end_date")
  status           String   @default("mapping")   // uploading | mapping | analyzing | completed | failed
  headerRow        Int      @default(0)           @map("header_row")
  dataStartRow     Int      @default(0)           @map("data_start_row")
  dataEndRow       Int      @default(0)           @map("data_end_row")
  columnMapping    Json?    @map("column_mapping") // { dateCol, descCol, debitCol, creditCol, balanceCol }
  totalDeposits    Decimal  @default(0)           @map("total_deposits")
  totalWithdrawals Decimal  @default(0)           @map("total_withdrawals")
  transactionCount Int      @default(0)           @map("transaction_count")
  rawData          Json?    @map("raw_data")      // ط´ط¨ظƒط© ط§ظ„ظ…ظ„ظپ ظƒط§ظ…ظ„ط© (ط­طھظ‰ ط­ط¯ ط§ظ„ط®ط§ط¯ظ…) ظ„ط¥ط¹ط§ط¯ط© ط§ظ„ط±ط¨ط·
  summaryJson      Json?    @map("summary_json") // opening/closing/by_category/pos_terminals (Base44)
  aiAnalysis       String?  @map("ai_analysis") @db.Text
  createdAt        DateTime @default(now())       @map("created_at")
  updatedAt        DateTime @updatedAt            @map("updated_at")

  company    Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions BankStatementTransaction[]

  @@index([tenantId])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("bank_statements")
}

model BankStatementTransaction {
  id          String   @id @default(cuid())
  statementId String   @map("statement_id")
  txDate      String   @map("tx_date")
  description String  @default("")
  categoryId  String?  @map("category_id")
  debit       Decimal  @default(0)   @map("debit")
  credit      Decimal  @default(0)   @map("credit")
  balance     Decimal? @map("balance")
  reference   String?  @map("reference")
  note        String?  @map("note")
  sortOrder   Int      @default(0)    @map("sort_order")
  matchKeyword       String?  @map("match_keyword")
  classificationName String?  @map("classification_name")
  transactionType    String?  @map("transaction_type")
  manuallyClassified Boolean  @default(false) @map("manually_classified")

  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  category  BankStatementCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([statementId])
  @@map("bank_statement_transactions")
}

// ظپط¦ط§طھ ط´ط¬ط±ظٹط© + ظƒظ„ظ…ط§طھ ظ…ظپطھط§ط­ظٹط© (ظ…ط·ط§ط¨ظ‚ط© BankCategory ظپظٹ Base44)
model BankTreeCategory {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  companyId         String   @map("company_id")
  name              String   @map("name")
  sortOrder         Int      @default(100) @map("sort_order")
  isActive          Boolean  @default(true) @map("is_active")
  transactionSide   String   @default("any") @map("transaction_side")
  transactionType   String?  @map("transaction_type")
  parentKeywords    Json     @map("parent_keywords")
  classifications   Json     @map("classifications")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([companyId])
  @@map("bank_tree_categories")
}

// ظ‚ظˆط§ط¹ط¯ طھطµظ†ظٹظپ ظ‚ط¯ظٹظ…ط©/ط¨ط³ظٹط·ط© (ظ…ط·ط§ط¨ظ‚ط© BankClassificationRule)
model BankClassificationRule {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  companyId         String   @map("company_id")
  keyword           String   @map("keyword")
  matchType         String   @default("contains") @map("match_type")
  categoryName      String   @map("category_name")
  transactionSide   String   @default("any") @map("transaction_side")
  transactionType   String?  @map("transaction_type")
  isActive          Boolean  @default(true) @map("is_active")
  priority          Int      @default(0) @map("priority")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([companyId])
  @@map("bank_classification_rules")
}

