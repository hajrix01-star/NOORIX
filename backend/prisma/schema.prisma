  workHours          String?  @map("work_hours")       // ط³ط§ط¹ط§طھ ط§ظ„ط¹ظ…ظ„ (ظ…ط«ظ„: 8 ط³ط§ط¹ط§طھ ظٹظˆظ…ظٹط§ظ‹)
  workSchedule       String?  @map("work_schedule")    // ظ†ط¸ط§ظ… ط§ظ„ط¯ظˆط§ظ… (ظ…ط«ظ„: ظ…ظ† ط§ظ„ط£ط­ط¯ ط¥ظ„ظ‰ ط§ظ„ط®ظ…ظٹط³)
  joinDate           DateTime @map("join_date")        // ط£ط³ط§ط³ ط­ط³ط§ط¨ ظ†ظ‡ط§ظٹط© ط§ظ„ط®ط¯ظ…ط©
  status             String   @default("active")       // active | terminated | on_leave
  notes              String?
  photoPath          String?  @map("photo_path") @db.Text
  photoMime          String?  @map("photo_mime")
  photoOriginalName  String?  @map("photo_original_name")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt      @map("updated_at")

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices      Invoice[]
  ledgerEntries LedgerEntry[]
  payrollRuns   PayrollRunItem[]
  leaves        Leave[]
  residencies   EmployeeResidency[]
