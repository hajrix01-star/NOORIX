  vaultSplits PayrollRunItemVault[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payroll_run_items")
}

// طھظˆط²ظٹط¹ ط§ظ„ط¯ظپط¹ ط¹ظ„ظ‰ ط®ط²ط§ط¦ظ† ظ…طھط¹ط¯ط¯ط© ظ„ظƒظ„ ط¨ظ†ط¯ ظپظٹ ط§ظ„ظ…ط³ظٹط±ط©
model PayrollRunItemVault {
