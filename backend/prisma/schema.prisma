// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ

// â”€â”€ ط¬ط¯ظˆظ„ ط§ظ„ظ…ظˆط¸ظپظٹظ† â€” ظ†ظˆط§ط© ظ†ط¸ط§ظ… HR ط§ظ„ظ…طھظƒط§ظ…ظ„ â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Employee {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")        // RLS
  companyId          String   @map("company_id")
  employeeSerial     String   @map("employee_serial")  // ط§ظ„ط±ظ‚ظ… ط§ظ„ظˆط¸ظٹظپظٹ (ظ…ط«ظ„ MS-ST-001)
  name               String                            // ط§ظ„ط§ط³ظ… ط§ظ„ظƒط§ظ…ظ„
  nameEn             String?  @map("name_en")
  iqamaNumber        String?  @map("iqama_number")     // ط±ظ‚ظ… ط§ظ„ط¥ظ‚ط§ظ…ط©
  jobTitle           String?  @map("job_title")        // ط§ظ„ظ…ط³ظ…ظ‰ ط§ظ„ظˆط¸ظٹظپظٹ
  basicSalary        Decimal  @map("basic_salary")     @db.Decimal(18, 4)
  housingAllowance   Decimal  @default(0) @map("housing_allowance")    @db.Decimal(18, 4)
  transportAllowance Decimal  @default(0) @map("transport_allowance")  @db.Decimal(18, 4)
