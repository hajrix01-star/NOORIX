{
  "name": "noorix-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Noorix ERP Backend — NestJS + Prisma + PostgreSQL",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "test": "jest --config jest.config.cjs",
    "test:integration:financial": "cross-env FINANCIAL_INTEGRATION_TEST=1 jest --config jest.config.cjs",
    "prestart:dev": "powershell -ExecutionPolicy Bypass -File ../scripts/kill-port.ps1 -Port 3000",
    "build": "npx prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:prod:full": "npx prisma migrate deploy && node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:deploy": "prisma migrate deploy",
    "db:delete-vip-moallim": "node prisma/delete-companies.js",
    "db:seed-hajri-history": "node prisma/seed-vat-planning-history.js",
    "db:repair-hajri-active": "node prisma/repair-hajri-vat-active-company.js",
    "audit:http-surface": "node scripts/audit-http-surface.mjs",
    "check:service-footprint": "node ../scripts/check-heavy-service-footprint.mjs",
    "test:financial": "jest --config jest.config.cjs financial-core-helpers.util.spec.ts financial-outflow-ledger.util.spec.ts"
  },
  "dependencies": {
    "@nestjs/bull": "^10.2.3",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "decimal.js": "^10.4.3",
    "dotenv": "^17.3.1",
    "helmet": "^8.1.0",
    "moment-timezone": "^0.5.46",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.10",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "multer": "^2.1.1",
    "tar": "^7.5.11"
  }
}
