{
  "version": 1,
  "description": "Baseline for central CSS footprint. This check blocks unreviewed CSS growth while the theme cleanup runs incrementally.",
  "files": {
    "src/index.css": {
      "maxLines": 6952,
      "maxMediaQueries": 51,
      "maxImportant": 215,
      "maxKeyframes": 12,
      "maxCssVariableDefinitions": 233,
      "maxCssVariableReferences": 895,
      "maxColorMix": 155
    },
    "src/ui/ui.css": {
      "maxLines": 2363,
      "maxMediaQueries": 6,
      "maxImportant": 22,
      "maxKeyframes": 8,
      "maxCssVariableDefinitions": 12,
      "maxCssVariableReferences": 295,
      "maxColorMix": 1
    },
    "src/modules/SmartChat/SmartChatScreen.css": {
      "maxLines": 945,
      "maxMediaQueries": 5,
      "maxImportant": 8,
      "maxKeyframes": 3,
      "maxCssVariableDefinitions": 0,
      "maxCssVariableReferences": 79,
      "maxColorMix": 11
    }
  },
  "selectorGroups": {
    "src/index.css": {
      "table": {
        "pattern": "(noorix-table|nx-table|nx-col-|nx-row-number|nx-orders-summary-table|nx-expense-line-table)",
        "maxMatches": 288
      },
      "modal": {
        "pattern": "(modal-|nx-modal|nx-drawer|payroll-run-form-drawer|invoice-edit-modal)",
        "maxMatches": 116
      },
      "shell": {
        "pattern": "(app-main|noorix-sidebar|noorix-topbar|user-menu|app-shell)",
        "maxMatches": 73
      },
      "dashboard": {
        "pattern": "(dashboard|calendar|kpi|stat-card|summary-bar)",
        "maxMatches": 125
      },
      "reports": {
        "pattern": "(reports|nx-pl|nx-gr2|pl-|bank-analysis|costAccounting|result-panel)",
        "maxMatches": 218
      },
      "invoices": {
        "pattern": "(invoice|inv-)",
        "maxMatches": 116
      },
      "orders": {
        "pattern": "(orders|catalog|items-manage)",
        "maxMatches": 28
      },
      "hr": {
        "pattern": "(hr-|payroll|employee|staff|residency|salary|EOS|termination)",
        "maxMatches": 184
      },
      "print": {
        "pattern": "(@media print|print-)",
        "maxMatches": 29
      }
    },
    "src/ui/ui.css": {
      "table": {
        "pattern": "(noorix-table|nx-table|nx-col-|nx-row-number|nx-orders-summary-table|nx-expense-line-table)",
        "maxMatches": 93
      },
      "modal": {
        "pattern": "(modal-|nx-modal|nx-drawer|payroll-run-form-drawer|invoice-edit-modal)",
        "maxMatches": 84
      },
      "dashboard": {
        "pattern": "(dashboard|calendar|kpi|stat-card|summary-bar)",
        "maxMatches": 24
      }
    }
  }
}
