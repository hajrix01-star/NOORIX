# انسخ المقتطفات المناسبة داخل كتلة server { ... } لموقع الواجهة، أو شغّل:
#   sudo bash deploy/install-nginx-frontend-cache.sh
# (ينسخ deploy/nginx-frontend-cache.snippet.conf إلى /etc/nginx/snippets/ ويضيف include تلقائياً)
# يجب أن يطابق `root` هنا المسار نفسه المعرّف لنشر الواجهة على السيرفر (مصدر واحد):
#   - الافتراضي في deploy/install-frontend.sh هو /var/www/noorix/dist (مطابق لـ root في Nginx لـ hajrix.com على الإنتاج الحالي)
#   - أو سطر واحد في الملف: /etc/noorix/frontend-root (يُنشأ مرة واحدة على الـ VPS إذا كان root مختلفاً)
# للتحقق بعد النشر: curl -s https://نطاقك/ | يجب أن يظهر <meta name="noorix-build" content="(نفس SHA في GitHub)"/>
# الهدف: منع بقاء index.html أو service worker في كاش المتصفح/الـCDN بينما السيرفر يخدم حزماً جديدة.
#
# مهم — lazy chunks (مثل SuppliersScreen-*.js):
# إذا كان location / يستخدم try_files … /index.html فطلب ملف غير موجود تحت /assets/
# يعيد index.html بنوع text/html فيُرفض الـ import الديناميكي (خطأ MIME في المتصفح).
# ضع كتلة /assets/ أدناه داخل نفس server { } وقبل أو بجانب location / — الأنسب نسخها كما هي.

# أصول Vite: لا تسقط إلى SPA؛ الملف المفقود = 404 (وليس index.html)
location ^~ /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
}

# SPA — غالباً موجود لديك مسبقاً
# location / {
#   try_files $uri $uri/ /index.html;
# }

location = /index.html {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
}

# Vite PWA — أسماء قد تختلف قليلاً؛ راقب مجلد dist بعد build
location = /sw.js {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
}

location = /manifest.webmanifest {
    add_header Cache-Control "no-cache, must-revalidate" always;
}
