# ---------------------------------------------------------------------------
# Noorix — Nginx: توجيه /api/ إلى الـ API (نمط احترافي: upstream + keepalive)
# ---------------------------------------------------------------------------
# ضع الـ upstream عادة في http { } أو في ملف include داخل http { }:
#
#   upstream noorix_api {
#       server 127.0.0.1:3000;
#       keepalive 32;
#   }
#
# ثم داخل server { } لموقع hajrix.com (قبل try_files الـ SPA إن وُجد):
# ---------------------------------------------------------------------------

location /api/ {
    proxy_pass http://noorix_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_connect_timeout 10s;
    proxy_send_timeout 120s;
}

# ملاحظات:
# 502: غالباً الـ Node غير شغّال أو منفذ upstream خاطئ.
# اختبر من السيرفر:  curl -sS http://127.0.0.1:3000/api/v1/health/live
# اختبر عبر النطاق:     curl -sS -f https://hajrix.com/api/v1/health
#
#   sudo nginx -t && sudo systemctl reload nginx
