{
  "name": "noorix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "predev": "powershell -ExecutionPolicy Bypass -File scripts/kill-port.ps1 -Port 5173",
    "start:dev": "npm run start:dev --prefix backend",
    "dev": "vite",
    "build": "npm run build --prefix packages/finance-core && npm run build --prefix packages/permissions-core && vite build",
    "preview": "vite preview",
    "test": "npm run build --prefix packages/finance-core && npm run build --prefix packages/permissions-core && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "ui:audit": "node scripts/ui-audit.mjs",
    "ui:audit:strict": "node scripts/ui-audit.mjs --strict",
    "check:table-governance": "node scripts/check-table-governance.mjs",
    "check:control-governance": "node scripts/check-control-governance.mjs",
    "check:date-control-governance": "node scripts/check-date-control-governance.mjs",
    "check:dashboard-governance": "node scripts/check-dashboard-governance.mjs",
    "check:invoices-governance": "node scripts/check-invoices-governance.mjs",
    "check:hr-governance": "node scripts/check-hr-governance.mjs",
    "check:reports-governance": "node scripts/check-reports-governance.mjs",
    "check:settings-governance": "node scripts/check-settings-governance.mjs",
    "check:suppliers-governance": "node scripts/check-suppliers-governance.mjs",
    "check:owner-governance": "node scripts/check-owner-governance.mjs",
    "check:purchases-governance": "node scripts/check-purchases-governance.mjs",
    "check:sales-governance": "node scripts/check-sales-governance.mjs",
    "check:responsive-governance": "node scripts/check-responsive-governance.mjs",
    "check:timing-governance": "node scripts/check-timing-governance.mjs",
    "check:filter-governance": "node scripts/check-filter-governance.mjs",
    "check:css-governance": "node scripts/check-css-governance.mjs",
    "check:inline-style-governance": "node scripts/check-inline-style-governance.mjs",
    "check:workflow-governance": "node scripts/check-workflow-governance.mjs",
    "verify:git-cleanliness": "node scripts/verify-git-cleanliness.mjs",
    "check:service-footprint": "node scripts/check-heavy-service-footprint.mjs",
    "check:scripts": "node scripts/check-node-scripts.mjs",
    "test:financial": "npm run test:financial --prefix backend",
    "audit:large-files": "node scripts/audit-large-files.mjs"
  },
  "dependencies": {
    "@noorix/finance-core": "file:packages/finance-core",
    "@noorix/permissions-core": "file:packages/permissions-core",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.21.3",
    "@umalqura/core": "^0.0.7",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.0.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "ts-morph": "^28.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^2.0.0",
    "workbox-window": "^7.4.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "serialize-javascript": "^6.0.2"
  }
}
